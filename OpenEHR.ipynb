mkdir ehrbase-docker && cd ehrbase-docker
nano docker-compose.yml
##File Start

version: '3.8'

services:
  ehrbase:
    image: ehrbase/ehrbase:latest
    container_name: ehrbase
    ports:
      - "8080:8080"
    environment:
      DB_URL: jdbc:postgresql://ehrdb:5432/ehrbase
      DB_USER: ehrbase
      DB_PASS: ehrbase
    depends_on:
      - ehrdb

  ehrdb:
    image: postgres:13
    container_name: ehrdb
    restart: always
    environment:
      POSTGRES_USER: ehrbase
      POSTGRES_PASSWORD: ehrbase
      POSTGRES_DB: ehrbase
    volumes:
      - ehrbase_pgdata:/var/lib/postgresql/data

volumes:
  ehrbase_pgdata:

## File End
docker compose up -d
docker ps
curl http://localhost:8080/ehrbase/rest/openehr/v1/ehr

