#Run openEHR (EHRbase) via Docker
sudo apt update
sudo apt install docker.io -y
sudo systemctl enable docker
sudo systemctl start docker
sudo usermod -aG docker $USER
#Run EHRbase with PostgreSQL using Docker Compose
mkdir ehrbase-docker && cd ehrbase-docker
nano docker-compose.yml
##{ File Start

version: '3.8'

services:
  ehrdb:
    image: postgres:13
    container_name: ehrdb
    environment:
      POSTGRES_USER: ehrbase
      POSTGRES_PASSWORD: ehrbase
      POSTGRES_DB: ehrbase
    ports:
      - "5432:5432"
    volumes:
      - ehrdata:/var/lib/postgresql/data

  ehrbase:
    image: ehrbase/ehrbase:latest
    container_name: ehrbase
    depends_on:
      - ehrdb
    ports:
      - "8080:8080"
    environment:
      DB_URL: jdbc:postgresql://ehrdb:5432/ehrbase
      DB_USER: ehrbase
      DB_PASS: ehrbase
      TZ: UTC
    restart: always

volumes:
  ehrdata: {}


#}






# Start docker
docker-compose up -d

# Test Local 

curl http://localhost:8080/ehrbase/rest/openehr/v1/ehr

#Check logs
curl http://localhost:8080/ehrbase/rest/openehr/v1/ehr

#stop container
docker-compose down




#PostgreSQL

docker run -d \
  --name ehrdb \
  -e POSTGRES_USER=ehrbase \
  -e POSTGRES_PASSWORD=ehrbase \
  -e POSTGRES_DB=ehrbase \
  -p 5432:5432 \
  postgres:13

sudo apt install postgresql-client -y
psql -h localhost -U ehrbase -d ehrbase
docker ps

